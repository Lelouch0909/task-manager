{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "https://taskmanager.212.227.80.225.sslip.io/actuator/health/readiness"
    },
    {
      "source": "/api/:path*",
      "destination": "https://taskmanager.212.227.80.225.sslip.io/api/:path*"
    },
    {
      "source": "/((?!api/|assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [{ "key": "Cache-Control", "value": "private, no-store" }]
    }
  ]
}
