MYSQL_DATABASE=taskmanager
MYSQL_USER=taskmanager
MYSQL_PASSWORD=replace-with-a-local-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password
MYSQL_PORT=3307
JWT_SECRET=replace-with-at-least-32-random-bytes
CODE_SECRET=replace-with-a-different-random-secret-at-least-32-bytes
RESEND_API_KEY=
RESEND_FROM=Task Manager <noreply@your-verified-domain.example>
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
COOKIE_SECURE=false
SWAGGER_ENABLED=true
